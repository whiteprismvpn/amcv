---
import { resume } from '../data/resume';
import '../styles/resume.css';
---
<html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{resume.name} — {resume.role}</title></head><body><main><section class="hero"><header><a class="logo" href="/">{resume.name}.</a><div class="contact">{resume.phone} <span>/</span> <a href={`mailto:${resume.email}`}>{resume.email}</a></div><a class="menu" href="#about">Меню</a></header><div class="hero-copy"><p class="eyebrow">{resume.location}</p><h1>Я —<br />{resume.role}</h1><a class="resume-link" href="#about">Смотреть резюме</a></div><div class="orb"></div></section><nav class="mobile-nav"><a href="#about">Обо мне</a><a href="#experience">Опыт</a><a href="#skills">Навыки</a><a href="#portfolio">Портфолио</a><a href="#contact">Контакты</a></nav><section id="about" class="section about"><p class="eyebrow">/ Обо мне</p><h2>{resume.about}</h2></section><section id="experience" class="section"><p class="eyebrow">/ Опыт</p>{resume.experience.map((item) => <article class="row"><div><h3>{item.role}</h3><p>{item.company}</p></div><div><p>{item.period}</p><p>{item.description}</p></div></article>)}</section><section id="skills" class="section"><p class="eyebrow">/ Навыки</p><div class="chips">{resume.skills.map((skill) => <span>{skill}</span>)}</div></section><section id="portfolio" class="section"><p class="eyebrow">/ Портфолио</p><div class="projects">{resume.projects.map((project) => <a class="project" href={project.url}><h3>{project.title}</h3><p>{project.description}</p><span>Смотреть →</span></a>)}</div></section><footer id="contact"><h2>Давайте работать вместе.</h2><a href={`mailto:${resume.email}`}>{resume.email}</a><div>{resume.social.map((item) => <a href={item.url}>{item.label}</a>)}</div><small>© {new Date().getFullYear()} {resume.name}. Все права защищены.</small></footer></main></body></html>